#include "outfit_backpack_upgrades\b_small_pack_up.ltx"
#include "outfit_backpack_upgrades\b_backpack_up.ltx"
#include "outfit_backpack_upgrades\b_military_pack_up.ltx"
#include "outfit_backpack_upgrades\b_tourist_pack_up.ltx"

[equ_backpack]
GroupControlSection                      = spawn_group
discovery_dependency                     =
$spawn                                   = "equipments\backpack"
$prefetch                                = 32
class                                    = EQ_BAKPK
cform                                    = skeleton
visual                                   = dynamics\devices\dev_rukzak\dev_pilbox.ogf
description                              = st_equ_backpack_desc
inv_weight                               = 1
inv_name                                 = st_equ_backpack_name
inv_name_short                           = st_equ_backpack_name
inv_grid_width                           = 2
inv_grid_height                          = 2
inv_grid_x                               = 34
inv_grid_y                               = 39
cost                                     = 15000
highlight_equipped 						 = true
slot                                     = 12
additional_inventory_weight				 = 10
additional_inventory_weight2			 = 10
use_condition							 = false
can_stack 								 = true
default_to_ruck                          = false
sprint_allowed							 = true
immunities_sect                          = sect_backpack_immunities
control_inertion_factor					 = 1.0
power_loss								 = 0.08 ;NEW FORMULA BELOW
; power restore (0.0 base) * (0.5 + outfit power loss + helmet power loss + backpack power loss)
;use1_functor                             = actor_backpack.query_create_stash
;use1_action_functor                      = actor_backpack.action_create_stash

upgrades								 = up_gr_firstab_backpack, up_gr_seconab_backpack			; * Dear modders, backpacks can have upgrades *
upgrade_scheme							 = upgrade_scheme_backpack

[sect_backpack_immunities]
burn_immunity                            = 0.0
strike_immunity                          = 0.0
shock_immunity                           = 0.0
wound_immunity                           = 0.0
wound_2_immunity                         = 0.0
radiation_immunity                       = 0.0
telepatic_immunity                       = 0.0
chemical_burn_immunity                   = 0.0
explosion_immunity                       = 0.0
fire_wound_immunity                      = 0.0

[equ_small_pack]:equ_backpack
visual                                   = dynamics\devices\dev_rukzak\dev_vkbo.ogf
description                              = st_equ_smallpack_desc
inv_weight                               = 0.5
inv_name                                 = st_equ_smallpack_name
inv_name_short                           = st_equ_smallpack_name
inv_grid_width                           = 2
inv_grid_height                          = 2
inv_grid_x                               = 34
inv_grid_y                               = 37
cost                                     = 7000
additional_inventory_weight				 = 5
additional_inventory_weight2			 = 5
power_loss								 = 0.03

upgrades								 = up_gr_firstab_smallbackpack
upgrade_scheme							 = upgrade_scheme_smallbackpack


[equ_military_pack]:equ_backpack
visual                                   = dynamics\devices\dev_rukzak\dev_drawbridge.ogf
